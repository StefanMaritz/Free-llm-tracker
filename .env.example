# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the three values.
# .env.local is git-ignored, so your keys never leave your machine.
# ---------------------------------------------------------------------------

# 1. Vercel AI Gateway - one key, every model (ChatGPT, Claude, Gemini, ...)
#    Get it at: https://vercel.com/dashboard  ->  AI Gateway  ->  API Keys
AI_GATEWAY_API_KEY=

# 2. Supabase - your database.
#    Dashboard -> your project -> Project Settings -> API Keys
#
#    URL:        the "Project URL", looks like https://abcdefg.supabase.co
#    SECRET KEY: the key labelled "secret", starts with sb_secret_
#                (older projects call this the "service_role" key - also fine)
#
#    The secret key bypasses all database security. Never put it in front-end
#    code and never commit it. That is why it has no NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Everything below is optional. The app works fine without it.
# ---------------------------------------------------------------------------

# How many prompts to generate per audit (default 15).
# Measured cost is about $0.025 per prompt across all five engines, so 15
# prompts is roughly $0.35 a run. Start at 5 while you are testing.
# TRACKER_PROMPT_COUNT=15

# Which engines to run. Comma separated. Default: all five.
# Drop some to cut cost while you are testing.
# TRACKER_ENGINES=chatgpt,claude,gemini,perplexity,grok

# Override individual models (any model id the AI Gateway supports).
# Model ids get retired without warning. If an engine starts failing with a 404,
# check the live list: https://ai-gateway.vercel.sh/v1/models
# TRACKER_MODEL_CHATGPT=openai/gpt-5.3-chat
# TRACKER_MODEL_CLAUDE=anthropic/claude-sonnet-4.6
# TRACKER_MODEL_GEMINI=google/gemini-3-flash
# TRACKER_MODEL_PERPLEXITY=perplexity/sonar
# TRACKER_MODEL_GROK=xai/grok-4.1-fast-non-reasoning

# The cheap models that write the prompts and score the answers.
# TRACKER_MODEL_ANALYZER=openai/gpt-4o-mini
# TRACKER_MODEL_JUDGE=openai/gpt-4o-mini
